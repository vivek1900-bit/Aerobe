{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "api/*.ts": {
      "runtime": "nodejs18.x",
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/advisor", "dest": "/api/advisor.ts", "methods": ["POST"] },
    { "src": "/api/plan", "dest": "/api/plan.ts", "methods": ["POST"] },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "env": {
    "GEMINI_API_KEY": "@gemini-api-key",
    "GEMINI_MODEL": "@gemini-model"
  }
}
