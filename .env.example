# AEROBE backend environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# Gemini API key from Google AI Studio (NOT the Gemini app student plan)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name from the AI Studio model list
# Example: gemini-1.5-flash, gemini-1.5-pro, etc.
GEMINI_MODEL=gemini-1.5-flash
